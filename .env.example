# Copy this file to .env and fill in the values.

# Required for live event data
TBA_API_KEY=

# Required for Google sign-in (leave blank to run guest-only)
GOOGLE_CLIENT_ID=

# Comma-separated emails to bootstrap as global admin on first run
GLOBAL_ADMIN_EMAILS=you@example.com

# Bind address/port (defaults shown)
HOST=0.0.0.0
PORT=3000

# Set true once you're behind HTTPS (reverse proxy / Caddy / nginx with TLS)
REQUIRE_HTTPS=false

# Set true to block all non-loopback API access (rarely needed)
LOCAL_API_ONLY=false

# Where the SQLite database lives (defaults to ./data)
FF_DATA_DIR=/opt/fantasyfrc/data
