# Optional: only needed if you want a domain name + HTTPS in front of the app
# instead of hitting http://<container-ip>:3000 directly.
#
# Copy to /etc/nginx/conf.d/fantasyfrc.conf and adjust server_name.
# Get a cert with: certbot --nginx -d your-domain.example

server {
    listen 80;
    server_name your-domain.example;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
